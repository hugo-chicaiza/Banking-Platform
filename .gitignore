####################################################################
# .gitignore de la raíz — F-02
#
# Lo primero son los secretos. Lo demás son artefactos.
#
# Importante: .gitignore evita que un archivo se añada por descuido, pero NO
# protege un archivo que YA está versionado. Si una credencial llega a un
# commit, hay que rotarla: sigue en el historial aunque se borre el archivo.
# Ver SECURITY.md
####################################################################

# --- Secretos y configuración local ---------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.jks
*.keystore
secrets.json
appsettings.*.local.json
# Perfiles de publicación de Azure: contienen credenciales de despliegue.
*.PublishSettings
*.pubxml.user

# --- Python ---------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
# Entorno virtual que crea Oryx en el despliegue de Azure App Service.
antenv/
build/
dist/
*.egg-info/
.eggs/
.installed.cfg
pip-wheel-metadata/

# Cachés de herramientas
.mypy_cache/
.dmypy.json
.ruff_cache/
.pytest_cache/
.tox/
.nox/

# Cobertura y reportes de pruebas
.coverage
.coverage.*
coverage.xml
htmlcov/
nosetests.xml
reports/
**/reports/

# --- Node y Angular -------------------------------------------------
node_modules/
.angular/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
*.tsbuildinfo
# dist/ ya está cubierto arriba, pero se deja explícito el del frontend.
Frontend/dist/
Frontend/coverage/
Frontend/reports/

# --- Herramientas de análisis ---------------------------------------
.scannerwork/
.sonarqube/
.sonarlint/
# Reportes de SBOM y de escaneo
*.sarif
sbom*.json
sbom*.xml

# --- Editores e IDE -------------------------------------------------
.idea/
*.iml
*.swp
*.swo
*~
.history/
# De .vscode solo se versionan los archivos compartidos del equipo.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# --- Sistema operativo ----------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Base de datos y respaldos --------------------------------------
# Un respaldo de la base de pruebas contiene datos personales reales si se
# tomó de un entorno con datos de clientes.
*.bak
*.mdf
*.ldf
*.trn
*.sqlite
*.sqlite3
*.db

# --- Temporales -----------------------------------------------------
*.log
*.tmp
tmp/
temp/
