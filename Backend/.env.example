# ============================================================
# Banking-Platform Backend · variables de entorno
# Copiar a .env y completar. En Azure App Service se definen como
# "Application settings" (no se despliega el .env).
# ============================================================

# --- Aplicación ---
APP_ENV=development                 # development | staging | production
APP_NAME=banking-platform-backend
LOG_LEVEL=INFO                              # DEBUG | INFO | WARNING | ERROR
# Puerto no estándar. Local: solo loopback. Azure: APP_HOST=0.0.0.0 y WEBSITES_PORT=<APP_PORT>
APP_HOST=127.0.0.1
APP_PORT=8471

# --- Límite de peticiones por minuto e IP (ASVS 2.4.1) ---
# Sin configurar el proxy de Azure, todos los usuarios comparten el límite
LIMITE_PETICIONES_ACTIVO=true
LIMITE_LECTURA_POR_MINUTO=300
LIMITE_ESCRITURA_POR_MINUTO=60
LIMITE_SENSIBLE_POR_MINUTO=5                # PIN, login y autenticación ATM

# --- Azure SQL · parámetros comunes ---
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_PORT=1433
DB_ENCRYPT=yes                      # ASVS V12: TLS obligatorio hacia la BD
DB_TRUST_SERVER_CERTIFICATE=no
DB_CONNECTION_TIMEOUT=30
# sql = usuario/clave · managed_identity = Entra ID (recomendado en Azure, sin claves)
DB_AUTH_MODE=sql
AZURE_CLIENT_ID=                    # solo managed_identity user-assigned

# --- CooperativaDB (core: clientes, cuentas, ATM, créditos, caja) ---
COOPERATIVA_DB_SERVER=<servidor>.database.windows.net
COOPERATIVA_DB_NAME=CooperativaDB
COOPERATIVA_DB_USER=
COOPERATIVA_DB_PASSWORD=

# --- SeguridadDB (usuarios, grupos/roles, sesiones, PIN) ---
SEGURIDAD_DB_SERVER=<servidor>.database.windows.net
SEGURIDAD_DB_NAME=SeguridadDB
SEGURIDAD_DB_USER=
SEGURIDAD_DB_PASSWORD=

# --- WorkOS AuthKit (autenticación, F-03 · patrón BFF) ---
# Dashboard de WorkOS > API Keys. La API key (sk_test_... / sk_live_...) es SECRETA:
# solo en el .env del backend o en App Settings de Azure; nunca en el FE ni en el repo.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=                   # client_... (mismo entorno de WorkOS que la key)
# SECRETA. Cifra la cookie de sesión. Una distinta por entorno; si cambia, todos los
# usuarios deben volver a iniciar sesión. Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WORKOS_COOKIE_PASSWORD=
# URL de GET /api/v1/auth/callback vista desde el navegador. Cada instancia envía la suya
# a WorkOS, que solo verifica que esté en Redirects: local y Azure conviven sin pisarse.
# Solo https://, salvo localhost (el backend no arranca si no).
WORKOS_REDIRECT_URI=
# Origen del FE, sin ruta. Destino de las redirecciones y único origen aceptado en
# POST/PUT/PATCH/DELETE (CSRF). Registrar FRONTEND_URL/login en WorkOS > Sign-out redirect
FRONTEND_URL=
#
# Valores por modo (los dos deben coincidir y estar registrados en WorkOS Staging):
#   Local con frontend (Vite):   FRONTEND_URL=http://localhost:5173
#                                WORKOS_REDIRECT_URI=http://localhost:5173/api/v1/auth/callback
#     Documentación: http://localhost:5173/api/docs
#   Local solo backend (/api/docs): FRONTEND_URL=http://localhost:8471
#                                WORKOS_REDIRECT_URI=http://localhost:8471/api/v1/auth/callback
#     Login: http://localhost:8471/api/v1/auth/login?return_to=/api/docs (localhost, no 127.0.0.1)
#   Azure (APP_ENV=staging, /api/docs visible), detrás del proxy de Cloudflare:
#                                FRONTEND_URL=https://<dominio del frontend>
#                                WORKOS_REDIRECT_URI=https://<dominio del frontend>/api/v1/auth/callback
#     Documentación con sesión: https://<dominio del frontend>/api/docs

# Usuarios: los roles vienen de WorkOS (slugs: admin, asesor, cajero, supervisor,
# aprobador-credito, contador, auditor). Los ids internos se vinculan en la base con los
# ids de WorkOS del entorno de producción (el mismo WorkOS en local y en Azure):
#   SeguridadDB  Organizacion.Usuarios.KeyUsuario = id del usuario   (user_01...)
#                -> UsuarioID que se guarda en CreadoPor, RealizadoPor, etc.
#   CooperativaDB Organizacion.Agencia.KeyAgencia = id de la organización (org_01...)
#                -> IdAgencia del usuario
# Toda ruta protegida exige KeyUsuario de un usuario Activo: si no, 403
# USUARIO_NO_REGISTRADO antes de ejecutar nada. Un cambio en la base se aplica en la
# siguiente petición, sin volver a iniciar sesión.
# Los roles que dio WorkOS quedan en Organizacion.Usuarios.RolesWorkOS (solo si cambian)
# y en Auditoria.Auditoria.RolesWorkOS (escrituras, accesos denegados); las consultas
# los dejan en el log de la app (usuario=... roles=...). No se comparan con los grupos.

# HSM simulado de tarjetas (TAR-01, TAR-05, ATM-01). Solo desarrollo y pruebas: claves
# FICTICIAS en hexadecimal, nunca de un banco real. En APP_ENV=production no se usa
# (TAR-01 responde 503 PAN_NO_DISPONIBLE y TAR-05 503 HSM_NO_DISPONIBLE).
# Local y Azure deben tener LOS MISMOS valores: comparten la base donde está el PAN
# cifrado y el PIN Offset. Generar con: python -c "import secrets;print(secrets.token_hex(32))"
#   HSM_SIM_CLAVE_PAN: AES-256 (64 hex) que cifra el PAN en Pruebas.PanFicticio
#   HSM_SIM_CLAVE_PVK: 3DES (32 o 48 hex) para IBM 3624 PIN Offset
#   HSM_SIM_CLAVES_PIN_BLOCK: JSON keyReference -> AES-256 (64 hex) del PIN Block ISO-4
#   HSM_SIM_REFERENCIA_PIN_BLOCK: keyReference que usa POST /api/v1/pruebas/pin-block
# Ver Backend/docs/HSM-Thales.md para pasar al HSM real.
HSM_SIM_CLAVE_PAN=
HSM_SIM_CLAVE_PVK=
HSM_SIM_CLAVES_PIN_BLOCK={}
HSM_SIM_REFERENCIA_PIN_BLOCK=TEST-KEY-01
