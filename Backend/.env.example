# ============================================================
# Banking-Platform Backend · variables de entorno
# Copiar a .env y completar. En Azure App Service se definen como
# "Application settings" (no se despliega el .env).
# ============================================================

# --- Aplicación ---
APP_ENV=development                 # development | staging | production
APP_NAME=banking-platform-backend
LOG_LEVEL=INFO
# Puerto no estándar. Local: solo loopback. Azure: APP_HOST=0.0.0.0 y WEBSITES_PORT=<APP_PORT>
APP_HOST=127.0.0.1
APP_PORT=8471

# --- Límite de peticiones por minuto e IP (ASVS 2.4.1) ---
# Sin configurar el proxy de Azure, todos los usuarios comparten el límite
LIMITE_PETICIONES_ACTIVO=true
LIMITE_LECTURA_POR_MINUTO=300
LIMITE_ESCRITURA_POR_MINUTO=60
LIMITE_SENSIBLE_POR_MINUTO=5                # PIN, login y autenticación ATM

# --- Azure SQL · parámetros comunes ---
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_PORT=1433
DB_ENCRYPT=yes                      # ASVS V12: TLS obligatorio hacia la BD
DB_TRUST_SERVER_CERTIFICATE=no
DB_CONNECTION_TIMEOUT=30
# sql = usuario/clave · managed_identity = Entra ID (recomendado en Azure, sin claves)
DB_AUTH_MODE=sql
AZURE_CLIENT_ID=                    # solo managed_identity user-assigned

# --- CooperativaDB (core: clientes, cuentas, ATM, créditos, caja) ---
COOPERATIVA_DB_SERVER=<servidor>.database.windows.net
COOPERATIVA_DB_NAME=CooperativaDB
COOPERATIVA_DB_USER=
COOPERATIVA_DB_PASSWORD=

# --- SeguridadDB (usuarios, grupos/roles, sesiones, PIN) ---
SEGURIDAD_DB_SERVER=<servidor>.database.windows.net
SEGURIDAD_DB_NAME=SeguridadDB
SEGURIDAD_DB_USER=
SEGURIDAD_DB_PASSWORD=

# --- WorkOS AuthKit (autenticación, F-03 · patrón BFF) ---
# Dashboard de WorkOS > API Keys. La API key (sk_test_... / sk_live_...) es SECRETA:
# solo en el .env del backend o en App Settings de Azure; nunca en el FE ni en el repo.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=                   # client_... (mismo entorno de WorkOS que la key)
# SECRETA. Cifra la cookie de sesión. Una distinta por entorno; si cambia, todos los
# usuarios deben volver a iniciar sesión. Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WORKOS_COOKIE_PASSWORD=
# URL de GET /api/v1/auth/callback vista desde el navegador (a través del proxy del FE).
# Registrarla en WorkOS > Redirects. Local con Vite:
WORKOS_REDIRECT_URI=
# Origen del FE, sin ruta. Destino de las redirecciones y único origen aceptado en
# POST/PUT/PATCH/DELETE (CSRF). Registrar FRONTEND_URL/login en WorkOS > Sign-out redirect
FRONTEND_URL=
