####################################################################
# Variables de docker compose — F-02
#
# ÁMBITO: este archivo es SOLO para los contenedores de `docker-compose.yml`
# (el SQL Server local). La configuración de la aplicación va en
# `Backend/.env`, con su propia plantilla en `Backend/.env.example`.
#
# Son dos archivos porque son dos cosas distintas: aquí se configura el MOTOR
# de base de datos local; allí, cómo la aplicación se conecta a él.
#
# Uso:
#   cp .env.example .env          (PowerShell: Copy-Item .env.example .env)
#
# `.env` está en .gitignore y no se versiona nunca.
####################################################################

# --- Contraseña de `sa` del SQL Server local ------------------------
#
# Requisitos de SQL Server: al menos 8 caracteres, con mayúsculas, minúsculas,
# dígitos y un símbolo. Si no los cumple, el contenedor arranca y muere sin
# explicar por qué (hay que mirar `docker compose logs sqlserver`).
#
# Debe ser una contraseña NUEVA, no una que uses en otro sitio: queda en texto
# plano en este archivo y en la configuración del contenedor.
#
# Generar una:
#   PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 20 | % {[char]$_}) + '!aA1'
#   bash:       openssl rand -base64 18
#
# Se deja VACÍA a propósito: `docker compose up` falla con un mensaje claro si
# no se rellena. Un valor por defecto acabaría copiado a un servidor real.
MSSQL_SA_PASSWORD=
